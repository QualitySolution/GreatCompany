<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GreatCompany.Controls"
             xmlns:models="clr-namespace:GreatCompany.Data.Models"
             x:Class="GreatCompany.Controls.ReferencePicker"
             x:CompileBindings="True"
             x:DataType="vm:ReferencePickerViewModel">
    <Grid ColumnDefinitions="*,Auto">
        <AutoCompleteBox Grid.Column="0"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding Selected}"
                         ValueMemberBinding="{Binding Name, DataType=models:ReferenceItem}"
                         FilterMode="Contains"
                         Watermark="(не выбрано)"
                         MinWidth="180" />
        <Button Grid.Column="1" Content="..." Margin="4,0,0,0" Command="{Binding OpenJournalCommand}" />
    </Grid>
</UserControl>
