<Application x:Class="GreatCompany.GreatCompanyApp"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:QS.Project.Converters;assembly=QS.Project.Avalonia"
             xmlns:styling="using:FluentAvalonia.Styling">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/GreatCompanyPalette.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NumericIsNotZeroConverter x:Key="NumericIsNotZeroConverter" />
            <converters:ByteArrayToBitmapConverter x:Key="ByteArrayToBitmapConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <styling:FluentAvaloniaTheme PreferUserAccentColor="False"
                                     CustomAccentColor="{StaticResource QsColorSystemAccent}" />
        <StyleInclude Source="avares://QS.Project.Avalonia/Themes/QSProjectTheme.axaml" />
    </Application.Styles>

</Application>
