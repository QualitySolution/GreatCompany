<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GreatCompany.Journal.ViewModels.CashFlow"
             xmlns:models="clr-namespace:GreatCompany.Data.Models"
             x:Class="GreatCompany.Journal.Views.CashFlow.ActualExpenseJournalView"
             x:CompileBindings="True"
             x:DataType="vm:ActualExpenseJournalViewModel">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
            <Button Content="Создать" Command="{Binding CreateCommand}" />
            <Button Content="Изменить" Command="{Binding EditCommand}" />
            <Button Content="Удалить" Command="{Binding DeleteCommand}" />
            <Button Content="Обновить" Command="{Binding RefreshCommand}" />
            <Button Content="Создать по шаблону" Command="{Binding CreateFromTemplateCommand}" />
            <TextBox Width="300" Watermark="Поиск по назначению и проекту..." Text="{Binding Search}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding Selected}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  DoubleTapped="OnRowDoubleTapped">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Width="100" Binding="{Binding Date, DataType=models:ActualExpenseRow, StringFormat='{}{0:dd.MM.yyyy}'}" />
                <DataGridTextColumn Header="Назначение" Width="*" Binding="{Binding Purpose, DataType=models:ActualExpenseRow}" />
                <DataGridTextColumn Header="Сумма" Width="110" Binding="{Binding Amount, DataType=models:ActualExpenseRow, StringFormat='{}{0:N2}'}" />
                <DataGridTextColumn Header="НДС" Width="100" Binding="{Binding VatAmount, DataType=models:ActualExpenseRow, StringFormat='{}{0:N2}'}" />
                <DataGridTextColumn Header="Счёт" Width="130" Binding="{Binding AccountName, DataType=models:ActualExpenseRow}" />
                <DataGridTextColumn Header="Дивизион" Width="140" Binding="{Binding DivisionName, DataType=models:ActualExpenseRow}" />
                <DataGridTextColumn Header="Проект" Width="140" Binding="{Binding ProjectName, DataType=models:ActualExpenseRow}" />
                <DataGridTextColumn Header="Статья" Width="140" Binding="{Binding ArticleName, DataType=models:ActualExpenseRow}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
