<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:journal="clr-namespace:GreatCompany.Journal.ViewModels.Reference"
             x:Class="GreatCompany.Journal.Views.Reference.ProjectFilterView"
             x:CompileBindings="True"
             x:DataType="journal:ProjectFilterViewModel">
    <WrapPanel Orientation="Horizontal" Margin="5">
        <CheckBox Content="Показать архивные" IsChecked="{Binding ShowArchived}" />
    </WrapPanel>
</UserControl>
