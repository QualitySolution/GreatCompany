<Window x:Class="GreatCompany.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:fi="using:FluentIcons.Avalonia.Fluent"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:QS.Navigation.Views;assembly=QS.Project.Avalonia"
        Title="QS: Великая компания"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        d:DesignHeight="700"
        d:DesignWidth="1100"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Window.Resources>
        <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#F7FBFF" />
        <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#08B99B" />
        <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#08B99B" />
        <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#079E86" />
        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#0A346D" />
        <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0B3D79" />
        <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#082F63" />
        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#08B99B" />
    </Window.Resources>
    <fa:NavigationView x:Name="navigationView"
                       Background="#06275A"
                       IsPaneOpen="True"
                       IsSettingsVisible="False"
                       OpenPaneLength="260"
                       PaneDisplayMode="Left"
                       PaneTitle="Великая компания"
                       SelectionChanged="OnNavViewSelectionChanged">
        <fa:NavigationView.MenuItems>
            <fa:NavigationViewItem x:Name="mainMenuItem" Content="Главная">
                <fa:NavigationViewItem.IconSource>
                    <fi:FluentIconSource Icon="Home" />
                </fa:NavigationViewItem.IconSource>
            </fa:NavigationViewItem>
        </fa:NavigationView.MenuItems>
        <fa:NavigationView.FooterMenuItems>
            <fa:NavigationViewItem x:Name="changeLogMenuItem" Content="Что нового?">
                <fa:NavigationViewItem.IconSource>
                    <fi:FluentIconSource Icon="News" />
                </fa:NavigationViewItem.IconSource>
            </fa:NavigationViewItem>
        </fa:NavigationView.FooterMenuItems>
        <fa:NavigationView.Content>
            <views:NavigationManagerView x:Name="navigationManagerView" />
        </fa:NavigationView.Content>
    </fa:NavigationView>
</Window>
