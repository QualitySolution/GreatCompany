<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GreatCompany.ViewModels.CashFlow"
             xmlns:views="clr-namespace:GreatCompany.Views"
             xmlns:widgets="clr-namespace:QS.Views.Widgets;assembly=QS.Project.Avalonia"
             x:Class="GreatCompany.Views.CashFlow.ActualExpenseView"
             x:CompileBindings="True"
             x:DataType="vm:ActualExpenseViewModel">
    <StackPanel Margin="15" Spacing="10" MaxWidth="460" VerticalAlignment="Top">
        <TextBlock Text="Дата" />
        <CalendarDatePicker SelectedDate="{Binding Entity.Date}" HorizontalAlignment="Stretch" />
        <TextBlock Text="Назначение" />
        <TextBox Text="{Binding Entity.Purpose}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
        <TextBlock Text="Сумма" />
        <NumericUpDown Value="{Binding Entity.Amount}" Minimum="0" FormatString="0.00" />
        <TextBlock Text="Сумма НДС" />
        <NumericUpDown Value="{Binding Entity.VatAmount}" Minimum="0" FormatString="0.00" />
        <TextBlock Text="Счёт" />
        <widgets:EntityEntryView ViewModel="{Binding AccountEntry}" />
        <TextBlock Text="Статья" />
        <widgets:EntityEntryView ViewModel="{Binding ExpenseArticleEntry}" />
        <TextBlock Text="Проект" />
        <widgets:EntityEntryView ViewModel="{Binding ProjectEntry}" />
        <TextBlock Text="Подразделение" />
        <widgets:EntityEntryView ViewModel="{Binding DivisionEntry}" />
        <TextBlock Text="Ссылка на план" />
        <widgets:EntityEntryView ViewModel="{Binding PlannedExpenseEntry}" />
        <views:CardButtons Save="{Binding SaveCommand}" Cancel="{Binding CancelCommand}" />
    </StackPanel>
</UserControl>
