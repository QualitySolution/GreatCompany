<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GreatCompany.ViewModels.Reference"
             xmlns:views="clr-namespace:GreatCompany.Views"
             xmlns:models="clr-namespace:GreatCompany.Data.Models"
             xmlns:converters="clr-namespace:QS.Project.Converters;assembly=QS.Project.Avalonia"
             x:Class="GreatCompany.Views.Reference.AccountView"
             x:CompileBindings="True"
             x:DataType="vm:AccountViewModel">
    <StackPanel Margin="15" Spacing="10" MaxWidth="400" VerticalAlignment="Top">
        <TextBlock Text="Название" />
        <TextBox Text="{Binding Entity.Name}" />
        <TextBlock Text="Налоговый режим" />
        <ComboBox ItemsSource="{Binding TaxRegimeOptions}" SelectedItem="{Binding Entity.TaxRegime}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:TaxRegime">
                    <TextBlock Text="{Binding Converter={x:Static converters:EnumTitleConverter.Instance}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <views:CardButtons Save="{Binding SaveCommand}" Cancel="{Binding CancelCommand}" />
    </StackPanel>
</UserControl>
