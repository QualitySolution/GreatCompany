<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GreatCompany.ViewModels.Reference"
             xmlns:views="clr-namespace:GreatCompany.Views"
             xmlns:widgets="clr-namespace:QS.Views.Widgets;assembly=QS.Project.Avalonia"
             x:Class="GreatCompany.Views.Reference.DivisionView"
             x:CompileBindings="True"
             x:DataType="vm:DivisionViewModel">
    <StackPanel Margin="15" Spacing="10" MaxWidth="400" VerticalAlignment="Top">
        <TextBlock Text="Название" />
        <TextBox Text="{Binding Entity.Name}" />
        <TextBlock Text="Головное подразделение" />
        <widgets:EntityEntryView ViewModel="{Binding ParentDivisionEntry}" />
        <views:CardButtons Save="{Binding SaveCommand}" Cancel="{Binding CancelCommand}" />
    </StackPanel>
</UserControl>
