<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GreatCompany.ViewModels.Reference"
             xmlns:views="clr-namespace:GreatCompany.Views"
             xmlns:widgets="clr-namespace:QS.Views.Control;assembly=QS.Project.Avalonia"
             x:Class="GreatCompany.Views.Reference.DivisionView"
             x:CompileBindings="True"
             Background="{DynamicResource QsBrushCanvas}"
             x:DataType="vm:DivisionViewModel">
    <DockPanel>
        <views:CardButtons DockPanel.Dock="Top" Margin="8" Save="{Binding SaveCommand}" Cancel="{Binding CancelCommand}" />
        <Border Classes="card" Margin="8,0,8,8" Width="400" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel Spacing="10">
                <TextBlock Text="Название" />
                <TextBox Text="{Binding Entity.Name}" />
                <TextBlock Text="Головное подразделение" />
                <widgets:EntityEntryView ViewModel="{Binding ParentDivisionEntry}" />
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
