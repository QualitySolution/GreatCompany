<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GreatCompany.ViewModels.Reference"
             x:Class="GreatCompany.Views.Reference.ExpenseArticleView"
             x:CompileBindings="True"
             x:DataType="vm:ExpenseArticleViewModel">
    <StackPanel Margin="15" Spacing="10" Width="400" VerticalAlignment="Top">
        <TextBlock Text="Название" />
        <TextBox Text="{Binding Entity.Name}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" />
            <Button Content="Отмена" Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
