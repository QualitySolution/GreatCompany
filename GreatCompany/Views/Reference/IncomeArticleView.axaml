<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GreatCompany.ViewModels.Reference"
             xmlns:views="clr-namespace:GreatCompany.Views"
             x:Class="GreatCompany.Views.Reference.IncomeArticleView"
             x:CompileBindings="True"
             x:DataType="vm:IncomeArticleViewModel">
    <StackPanel Margin="15" Spacing="10" MaxWidth="400" VerticalAlignment="Top">
        <TextBlock Text="Название" />
        <TextBox Text="{Binding Entity.Name}" />
        <views:CardButtons Save="{Binding SaveCommand}" Cancel="{Binding CancelCommand}" />
    </StackPanel>
</UserControl>
